# Firebase Web Configuration (Client-side public identifiers, NOT admin secrets)
# Copy this file to .env.local and fill in your Firebase development project values.
VITE_FIREBASE_API_KEY=your-dev-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-dev-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-dev-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-dev-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Emulator & Demo Controls
# Set VITE_USE_EMULATORS=true when running local Firebase Auth/Firestore/Storage emulators
VITE_USE_EMULATORS=true

# Set VITE_DEMO_MODE=true to explicitly render labelled [SAMPLE DATA] fixtures without connecting to Firebase
VITE_DEMO_MODE=true
